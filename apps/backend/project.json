{
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend/app",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --dev",
        "cwd": "apps/backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
        "cwd": "apps/backend"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run alembic upgrade head",
        "cwd": "apps/backend"
      }
    },
    "migration-current": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run alembic current",
        "cwd": "apps/backend"
      }
    },
    "migration-history": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run alembic history",
        "cwd": "apps/backend"
      }
    },
    "seed-loadtest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m scripts.seed_load_test_data",
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "REDIS_URL= uv run pytest -q",
        "cwd": "apps/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check app tests alembic",
        "cwd": "apps/backend"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check app tests alembic && REDIS_URL= uv run pytest -q",
        "cwd": "apps/backend"
      }
    }
  }
}
