{
  "name": "user-management-frontend-ts",
  "author": "minimals.cc",
  "licence": "MIT",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3001",
    "dev": "vite --host 127.0.0.1 --port 3001",
    "build": "tsc --noEmit --pretty false -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --trace on",
    "generate:api-types": "openapi-typescript ../../docs/api/openapi.yaml -o src/generated/api-types.ts",
    "lint": "eslint --ext .ts,.tsx ./src",
    "lint:fix": "eslint --fix --ext .ts,.tsx ./src",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "clear-all": "rm -rf dist node_modules",
    "re-start": "rm -rf dist node_modules && npm install && npm start",
    "re-build": "rm -rf dist node_modules && npm install && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.2",
    "@iconify/react": "^4.1.1",
    "@mui/lab": "^5.0.0-alpha.177",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^5.0.20",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "notistack": "^3.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.18.4",
    "redux": "^4.2.1",
    "redux-devtools-extension": "^2.13.9",
    "simplebar-react": "^3.3.2",
    "web-vitals": "^3.5.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
